# JudeTracker environment template.
# Copy this file to `.env` (next to compose.yaml) and adjust the values.
# Docker Compose reads `.env` automatically - no flags needed.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# --- Web app ---------------------------------------------------------------
# Port the app is served on (host + container + browser URL).
# 8080 is often taken by other projects, hence 8090.
APP_PORT=8090

# Set to true only when serving over HTTPS (Tailscale serve, Caddy,
# reverse proxy). Browser GPS / camera need a secure context.
COOKIE_SECURE=false

# --- Database (Postgres) ----------------------------------------------------
# Credentials used to create the database + user on FIRST BOOT of the db
# volume. If you change these after the volume exists, either recreate the
# volume (`docker compose down -v`) or keep them in sync manually.
POSTGRES_USER=judetracker
POSTGRES_PASSWORD=judetracker
POSTGRES_DB=judetracker

# Host:port that maps to Postgres inside Docker. Loopback-only by default so
# the database is not exposed to other machines. 5432 is often taken by WSL.
DB_HOST_PORT=127.0.0.1:5433

# --- Sessions ----------------------------------------------------------------
# How long a session lasts (minutes) before the PIN is asked again.
SESSION_TTL_MINUTES=20160   # 14 days
SESSION_IDLE_MINUTES=15     # auto-lock after inactivity

# --- Local (non-Docker) development only -------------------------------------
# These have sane defaults in server/src/config.ts; uncomment to override
# when running `npm run dev` / `npm run start` directly on the host.
# DATABASE_URL=postgres://judetracker:judetracker@127.0.0.1:5433/judetracker
# DATA_DIR=./data
# STATIC_DIR=./client/dist
